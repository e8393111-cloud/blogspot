# 로컬 파이프라인(pipeline/run.py)용 환경변수 — 복사해서 .env 로 쓰거나 셸에 export 하세요.
# (.env 파일은 자동으로 로드되지 않습니다. `export $(grep -v '^#' .env | xargs)` 처럼 직접 로드하거나
#  셸에서 직접 export 하세요.)

# Claude API 키 (https://console.anthropic.com → API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# (선택) 사용할 모델 / 인스타 핸들
CARDNEWS_MODEL=claude-opus-4-7
IG_HANDLE=@your_handle

# (선택) 로컬에 CJK 폰트가 없을 때 직접 지정 — 예: 다운로드한 Pretendard / Noto Sans KR
# CARD_FONT_REGULAR=/absolute/path/to/Pretendard-Regular.otf
# CARD_FONT_BOLD=/absolute/path/to/Pretendard-Bold.otf


# ───────────────────────────────────────────────────────────────────────────
# 렌더러 서비스(renderer/) 배포용 환경변수 — Render.com 등의 대시보드에 설정하세요.

# 배포된 서비스의 공개 URL (Instagram이 이미지를 가져갈 수 있어야 하므로 공개 HTTPS 여야 함)
# PUBLIC_BASE_URL=https://cardnews-renderer.onrender.com

# 렌더러 호출 보호용 키. /render 요청은 헤더  X-Api-Key: <이 값>  을 보내야 함.
# RENDER_API_KEY=change-me-to-a-long-random-string

# 렌더된 이미지를 메모리에 보관하는 시간(초). 기본 7200(2시간).
# RENDER_TTL_SECONDS=7200


# ───────────────────────────────────────────────────────────────────────────
# Make.com 시나리오용 — Make의 Custom variables 에 등록 (make/SETUP.md 참고)
#   ANTHROPIC_API_KEY, RENDERER_BASE_URL, RENDERER_API_KEY,
#   IG_USER_ID, IG_ACCESS_TOKEN, IG_HANDLE, CARDNEWS_THEME, BLOG_FEED_URL
