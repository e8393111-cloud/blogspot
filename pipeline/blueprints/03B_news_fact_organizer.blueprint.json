{
  "name": "03B_뉴스 팩트 정리기",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0,
          "name": "03A에서 웹훅 수신"
        },
        "expect": [
          { "name": "keyword", "type": "text", "label": "키워드" },
          { "name": "row_number", "type": "number", "label": "행 번호" },
          { "name": "news_count", "type": "number", "label": "기사 수" },
          { "name": "is_breaking", "type": "text", "label": "긴급 여부" },
          { "name": "event_category", "type": "text", "label": "이벤트 카테고리" },
          { "name": "articles", "type": "array", "label": "기사 배열" }
        ]
      }
    },
    {
      "id": 2,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "articles_for_ai",
            "value": "{{toString(map(1.articles; \"title\"; \"description\"; \"pubDate\"; \"originallink\"))}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0,
          "name": "기사 메타데이터 정리"
        }
      }
    },
    {
      "id": 3,
      "module": "openai:createChatCompletion",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 2
      },
      "mapper": {
        "model": "gpt-4o",
        "temperature": "0.2",
        "max_tokens": "1500",
        "response_format": "json_object",
        "messages": [
          {
            "role": "system",
            "content": "너는 뉴스 팩트체커다. 여러 기사의 제목, 요약, 발행시간, 원문링크를 받아서 사실만 추출한다.\n\n규칙:\n1. 기사 1개만으로 단정하지 않는다\n2. 최소 2개 이상 기사에서 공통으로 보이는 사실만 쓴다\n3. 회사 공식 설명이 있으면 official_explanation에 넣는다\n4. 충돌하는 내용이 있으면 confidence를 low로 하고 conflicting_info에 적는다\n5. 추측이나 의견은 절대 넣지 않는다\n\n반드시 아래 JSON 형식으로만 응답한다."
          },
          {
            "role": "user",
            "content": "키워드: {{1.keyword}}\n이벤트 카테고리: {{1.event_category}}\n\n수집된 기사 {{1.news_count}}건:\n{{2.articles_for_ai}}\n\n위 기사들에서 공통 사실만 추출하여 아래 형식으로 정리해줘:\n{\n  \"event_type\": \"service_outage | accident | breaking_news | controversy | trending | policy_change | product_launch | other\",\n  \"what_happened\": \"무슨 일이 있었는지 1~2문장\",\n  \"start_time\": \"발생 시각 (기사 기준)\",\n  \"current_status\": \"현재 상태 (정상화/진행중/미확인)\",\n  \"official_explanation\": \"회사 또는 기관의 공식 설명 (없으면 빈 문자열)\",\n  \"user_impact\": \"이용자에게 어떤 영향이 있었는지\",\n  \"what_users_can_do_now\": \"지금 사용자가 할 수 있는 것\",\n  \"confidence\": \"high | medium | low\",\n  \"conflicting_info\": \"충돌하는 내용이 있으면 여기에 (없으면 빈 문자열)\",\n  \"source_urls\": [\"원문 링크 배열\"]\n}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 600,
          "y": 0,
          "name": "OpenAI 사실 정리"
        }
      }
    },
    {
      "id": 4,
      "module": "json:ParseJSON",
      "version": 1,
      "parameters": {},
      "mapper": {
        "json": "{{3.choices[].message.content}}"
      },
      "metadata": {
        "designer": {
          "x": 900,
          "y": 0,
          "name": "JSON 파싱"
        }
      }
    },
    {
      "id": 5,
      "module": "util:SetVariables",
      "version": 1,
      "parameters": {},
      "mapper": {
        "variables": [
          {
            "name": "manual_review",
            "value": "{{if(4.confidence = \"high\"; if(4.conflicting_info = \"\"; \"NO\"; \"YES\"); \"YES\")}}"
          },
          {
            "name": "publish_mode",
            "value": "{{if(4.confidence = \"high\"; if(4.conflicting_info = \"\"; \"semi_auto\"; \"manual\"); \"manual\")}}"
          }
        ]
      },
      "metadata": {
        "designer": {
          "x": 1200,
          "y": 0,
          "name": "발행 모드 판정"
        }
      }
    },
    {
      "id": 6,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 1
      },
      "mapper": {
        "sheetId": "4_채널각도",
        "spreadsheetId": "{{SPREADSHEET_ID}}",
        "rowNumber": "{{1.row_number}}",
        "values": {
          "source_urls": "{{join(4.source_urls; \", \")}}",
          "fact_summary": "{{3.choices[].message.content}}",
          "content_mode": "breaking"
        }
      },
      "metadata": {
        "designer": {
          "x": 1500,
          "y": 0,
          "name": "4_채널각도 업데이트"
        }
      }
    },
    {
      "id": 7,
      "module": "google-sheets:updateRow",
      "version": 2,
      "parameters": {
        "__IMTCONN__": 1
      },
      "mapper": {
        "sheetId": "5_hub_queue",
        "spreadsheetId": "{{SPREADSHEET_ID}}",
        "rowNumber": "{{1.row_number}}",
        "values": {
          "publish_mode": "{{5.publish_mode}}",
          "manual_review": "{{5.manual_review}}",
          "event_expires_at": "{{formatDate(addHours(now; 24); \"YYYY-MM-DD HH:mm:ss\")}}"
        }
      },
      "metadata": {
        "designer": {
          "x": 1800,
          "y": 0,
          "name": "5_hub_queue 업데이트"
        }
      }
    },
    {
      "id": 8,
      "module": "http:ActionSendData",
      "version": 3,
      "parameters": {},
      "mapper": {
        "url": "{{05N_WEBHOOK_URL}}",
        "method": "post",
        "headers": [
          {
            "name": "Content-Type",
            "value": "application/json"
          }
        ],
        "bodyType": "raw",
        "contentType": "application/json",
        "body": "{\"keyword\":\"{{1.keyword}}\",\"row_number\":{{1.row_number}},\"event_category\":\"{{1.event_category}}\",\"fact_json\":{{3.choices[].message.content}},\"manual_review\":\"{{5.manual_review}}\",\"publish_mode\":\"{{5.publish_mode}}\"}",
        "parseResponse": false,
        "timeout": 15000
      },
      "metadata": {
        "designer": {
          "x": 2100,
          "y": 0,
          "name": "05N 뉴스형 제목 생성 호출"
        }
      }
    }
  ],
  "metadata": {
    "version": 1,
    "scenario": {
      "roundtrips": 1,
      "maxErrors": 3,
      "autoCommit": true,
      "autoCommitTriggerLast": true,
      "sequential": true,
      "slots": null,
      "confidential": false,
      "dataloss": false,
      "dlq": false,
      "freshVariables": false
    },
    "designer": {
      "orphans": []
    },
    "zone": "Asia/Seoul",
    "notes": "03B 뉴스 팩트 정리기\n\n흐름:\n1. 03A에서 웹훅으로 키워드 + 기사 배열 수신\n2. 기사 메타데이터(title/description/pubDate/originallink)만 추출\n3. OpenAI(gpt-4o)로 사실 종합 → 구조화 JSON 출력\n4. confidence/conflicting_info 기반 manual_review 판정\n5. 4_채널각도, 5_hub_queue 시트 업데이트\n6. 05N 뉴스형 제목 생성 시나리오 호출\n\n필요한 Connection:\n- Google Sheets (구글 계정 연동) → __IMTCONN__: 1\n- OpenAI (API Key) → __IMTCONN__: 2\n\n필요한 환경변수 (시나리오 변수로 설정):\n- SPREADSHEET_ID: 구글 시트 ID\n- 05N_WEBHOOK_URL: 05N 시나리오 웹훅 URL"
  }
}
