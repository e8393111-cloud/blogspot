{
  "description": "기존 시트에 추가할 컬럼 정의 - 뉴스 급행 라인용",
  "sheets": {
    "2_점수판": {
      "new_columns": [
        {
          "name": "news_count",
          "type": "number",
          "description": "최근 3시간 이내 관련 뉴스 기사 수",
          "default": 0
        },
        {
          "name": "is_breaking",
          "type": "string",
          "description": "장애/사고형 키워드 여부",
          "enum": ["YES", "NO"],
          "default": ""
        },
        {
          "name": "content_route",
          "type": "string",
          "description": "콘텐츠 라우팅 경로",
          "enum": ["SEO", "NEWS_FAST", "NEWS_STANDARD"],
          "default": ""
        },
        {
          "name": "event_category",
          "type": "string",
          "description": "감지된 이벤트 카테고리",
          "enum": ["서비스 장애/오류", "사건/사고", "속보/긴급", "논란/이슈", "화제/핫이슈", "정책/제도 변경", "신규 출시/오픈", "unclassified_hot"],
          "default": ""
        },
        {
          "name": "news_checked_at",
          "type": "datetime",
          "description": "뉴스 확인 시각",
          "format": "YYYY-MM-DD HH:mm:ss"
        }
      ]
    },
    "4_채널각도": {
      "new_columns": [
        {
          "name": "source_urls",
          "type": "string",
          "description": "출처 기사 URL 목록 (콤마 구분)"
        },
        {
          "name": "fact_summary",
          "type": "string",
          "description": "03B에서 생성된 사실 요약 JSON 문자열"
        },
        {
          "name": "content_mode",
          "type": "string",
          "description": "콘텐츠 성격",
          "enum": ["evergreen", "breaking", "recovery"],
          "default": "evergreen"
        }
      ]
    },
    "5_hub_queue": {
      "new_columns": [
        {
          "name": "publish_mode",
          "type": "string",
          "description": "발행 모드",
          "enum": ["auto", "semi_auto", "manual"],
          "default": "semi_auto"
        },
        {
          "name": "manual_review",
          "type": "string",
          "description": "수동 검토 필요 여부",
          "enum": ["YES", "NO"],
          "default": "NO"
        },
        {
          "name": "event_expires_at",
          "type": "datetime",
          "description": "이슈 만료 시각 (발행 후 24시간)",
          "format": "YYYY-MM-DD HH:mm:ss"
        }
      ]
    },
    "03A_수집기사": {
      "note": "신규 시트 - 03A에서 수집한 기사 원본 저장용",
      "columns": [
        {
          "name": "keyword",
          "type": "string",
          "description": "검색 키워드"
        },
        {
          "name": "news_count",
          "type": "number",
          "description": "수집된 기사 수"
        },
        {
          "name": "is_breaking",
          "type": "string",
          "description": "장애/사고형 여부"
        },
        {
          "name": "content_route",
          "type": "string",
          "description": "라우팅 결과"
        },
        {
          "name": "articles_json",
          "type": "string",
          "description": "수집된 기사 메타데이터 JSON"
        },
        {
          "name": "collected_at",
          "type": "datetime",
          "description": "수집 시각"
        }
      ]
    }
  },
  "news_detection_keywords": {
    "description": "이벤트 유형별 감지 키워드 세트. 기사 제목에서 매칭하여 event_category를 판정한다.",

    "outage": {
      "label": "서비스 장애/오류",
      "keywords": ["장애", "오류", "먹통", "복구", "점검", "접속불가", "서버다운", "중단", "마비", "다운", "불통", "지연", "차단", "중지", "접속장애", "시스템오류", "서비스중단"],
      "content_route": "NEWS_FAST",
      "min_match": 2,
      "priority": 1
    },

    "accident": {
      "label": "사건/사고",
      "keywords": ["사고", "사망", "부상", "충돌", "폭발", "화재", "붕괴", "전복", "추락", "침몰", "매몰", "실종", "구조", "대피", "피해"],
      "content_route": "NEWS_FAST",
      "min_match": 2,
      "priority": 1
    },

    "breaking": {
      "label": "속보/긴급",
      "keywords": ["속보", "긴급", "단독", "특보", "1보", "2보", "3보", "발표", "공식입장", "긴급회견", "브리핑"],
      "content_route": "NEWS_FAST",
      "min_match": 1,
      "priority": 1
    },

    "controversy": {
      "label": "논란/이슈",
      "keywords": ["논란", "파문", "물의", "비판", "반발", "항의", "시위", "고발", "폭로", "해명", "사과", "사퇴", "퇴진", "탄핵", "구속", "체포", "기소"],
      "content_route": "NEWS_FAST",
      "min_match": 2,
      "priority": 2
    },

    "trending": {
      "label": "화제/핫이슈",
      "keywords": ["화제", "폭등", "폭락", "급등", "급락", "신기록", "역대급", "최초", "첫", "돌파", "대란", "품절", "마감", "매진", "오픈런", "줄서기"],
      "content_route": "NEWS_STANDARD",
      "min_match": 2,
      "priority": 3
    },

    "policy": {
      "label": "정책/제도 변경",
      "keywords": ["시행", "개정", "변경", "인상", "인하", "폐지", "신설", "의무화", "규제", "완화", "금지", "허용", "적용", "대상확대"],
      "content_route": "NEWS_STANDARD",
      "min_match": 2,
      "priority": 3
    },

    "launch": {
      "label": "신규 출시/오픈",
      "keywords": ["출시", "오픈", "런칭", "공개", "발매", "사전예약", "베타", "업데이트", "신제품", "신규서비스"],
      "content_route": "NEWS_STANDARD",
      "min_match": 2,
      "priority": 4
    }
  },

  "detection_rules": {
    "description": "카테고리 판정 규칙",
    "rules": [
      "1. 모든 카테고리의 키워드를 기사 제목에서 매칭한다",
      "2. 각 카테고리별 min_match 이상 매칭되면 해당 카테고리로 판정",
      "3. 복수 카테고리 매칭 시 priority 숫자가 낮은(=더 긴급한) 것 우선",
      "4. 동일 priority면 매칭 수가 많은 카테고리 우선",
      "5. 아무 카테고리도 매칭 안 되면 뉴스 3건 이상일 때 NEWS_STANDARD",
      "6. NEWS_FAST 카테고리는 03B 즉시 호출, NEWS_STANDARD는 일반 뉴스 라인"
    ]
  }
}
